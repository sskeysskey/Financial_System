{
  "manifest_version": 3,
  "name": "Firstrade 股票标签助手",
  "version": "9.0",
  "description": "Firstrade 列表 Tag 徽章；持仓/订单(LEAN)/自选股行情回传本机 Python 图表；自选股一键同步；Python 图表远程加入/移出自选股分组；所有功能自动定位/跳转/新开 Firstrade 页面。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:18888/*",
    "http://localhost:18888/*",
    "https://invest.firstrade.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Firstrade 股票标签助手"
  },
  "content_scripts": [
    {
      "matches": [
        "https://invest.firstrade.com/*"
      ],
      "js": [
        "content.js",
        "watchlist.js",
        "wl_agent.js",
        "wl_membership.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}