{
  "manifest_version": 3,
  "name": "Firstrade 股票标签助手",
  "version": "11.0",
  "description": "Firstrade 列表 Tag 徽章；持仓/订单/Earning 行情回传本机；自选股一键同步；分组归属；自选股页+持仓页点击代码按股数快速交易；Python 远程加入/移出/交易/取变更%。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:18888/*",
    "http://localhost:18888/*",
    "https://invest.firstrade.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Firstrade 股票标签助手"
  },
  "content_scripts": [
    {
      "matches": [
        "https://invest.firstrade.com/*"
      ],
      "js": [
        "content.js",
        "watchlist.js",
        "wl_agent.js",
        "wl_membership.js",
        "ft_trade.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}