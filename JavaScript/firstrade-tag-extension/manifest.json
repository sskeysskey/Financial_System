{
  "manifest_version": 3,
  "name": "Firstrade 股票标签助手",
  "version": "2.0",
  "description": "在 Firstrade 列表中显示 Tag 徽章、悬停展示完整标签卡片，并支持点击直接唤起本地 Python 价格曲线。",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:18888/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Firstrade 股票标签助手"
  },
  "content_scripts": [
    {
      "matches": [
        "https://invest.firstrade.com/*",
        "https://*.firstrade.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}