{
  "manifest_version": 3,
  "name": "Firstrade 股票标签助手",
  "version": "7.0",
  "description": "Firstrade 列表 Tag 徽章；持仓/订单(LEAN)/自选股行情回传本机 Python 图表；自选股一键重建（可选先清空分组 → 比对差集 → 批量添加，数据源=财报日历/Sectors_All/本地清单）。全部自动抓取默认关闭。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:18888/*",
    "http://localhost:18888/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Firstrade 股票标签助手"
  },
  "content_scripts": [
    {
      "matches": [
        "https://invest.firstrade.com/*"
      ],
      "js": [
        "content.js",
        "watchlist.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}