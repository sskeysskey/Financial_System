{
    "manifest_version": 3,
    "name": "Screener Data Scraper",
    "version": "2.0",
    "description": "Scrape Yahoo Finance screener data (crash-proof background engine)",
    "permissions": [
        "scripting",
        "downloads",
        "storage",
        "tabs",
        "alarms"
    ],
    "host_permissions": [
        "https://finance.yahoo.com/*"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    }
}